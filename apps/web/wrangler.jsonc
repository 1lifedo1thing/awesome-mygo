{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "awesome-mygo",
	"compatibility_date": "2026-06-20",
	"compatibility_flags": ["nodejs_compat"],
	// TanStack Start's Worker entry: server-renders every route; the client bundle and public/ are served as static assets.
	"main": "@tanstack/react-start/server-entry",
	// The zone mygodock.dev must be on the Cloudflare account that deploys; the custom domain creates its DNS record and certificate.
	"routes": [{ "pattern": "mygodock.dev", "custom_domain": true }],
	"observability": { "enabled": true },
	// Anonymous submissions (/api/submit): at most 3 a minute from one IP. namespace_id only has to be unique within the Cloudflare account. The GitHub App and Turnstile keys are secrets (GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY); without them the form keeps to GitHub links.
	"ratelimits": [{ "name": "SUBMIT_LIMIT", "namespace_id": "4170", "simple": { "limit": 3, "period": 60 } }]
}
