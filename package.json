{
	"name": "awesome-mygo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "MyGo Dock: the awesome-mygo ecosystem site, served from Cloudflare Workers",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "pnpm --filter @awesome-mygo/web dev",
		"build": "pnpm --filter @awesome-mygo/web build",
		"preview": "pnpm --filter @awesome-mygo/web preview",
		"deploy": "pnpm --filter @awesome-mygo/web deploy",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
