{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "docs.schema.json",
	"title": "Official MyGo guides",
	"type": "object",
	"required": [
		"guides"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"guides": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"title",
					"file",
					"summary"
				],
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1
					},
					"file": {
						"type": "string",
						"minLength": 1,
						"description": "Path under egoist/mygo docs/."
					},
					"summary": {
						"$ref": "common.schema.json#/$defs/text"
					}
				}
			}
		}
	}
}
