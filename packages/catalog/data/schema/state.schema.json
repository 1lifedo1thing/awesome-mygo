{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "state.schema.json",
	"title": "State management for MyGo apps",
	"type": "object",
	"required": [
		"solutions"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"solutions": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"name",
					"author",
					"summary",
					"repo",
					"url",
					"install",
					"tags"
				],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"author": {
						"type": "string",
						"minLength": 1
					},
					"summary": {
						"$ref": "common.schema.json#/$defs/text"
					},
					"repo": {
						"$ref": "common.schema.json#/$defs/repo"
					},
					"url": {
						"$ref": "common.schema.json#/$defs/url"
					},
					"homepage": {
						"$ref": "common.schema.json#/$defs/url"
					},
					"install": {
						"type": "string",
						"minLength": 1,
						"description": "The install command, e.g. go get …"
					},
					"tags": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string"
						}
					},
					"screenshot": {
						"$ref": "common.schema.json#/$defs/screenshot"
					}
				}
			}
		}
	}
}
